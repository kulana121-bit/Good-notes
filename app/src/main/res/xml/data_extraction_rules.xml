<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="."/>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>

        <!-- Exclude auth tokens, temp files, and caches -->
        <exclude domain="root" path="cache" />
        <exclude domain="file" path="cache" />
        <exclude domain="file" path="temp" />
        <exclude domain="sharedpref" path="com.google.android.gms.auth.api.signin.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.signin.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="."/>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="root" path="cache" />
        <exclude domain="file" path="cache" />
        <exclude domain="file" path="temp" />
    </device-transfer>
</data-extraction-rules>
