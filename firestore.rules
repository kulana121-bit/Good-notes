rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for any collection outside users
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // User root document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Notes subcollection - only authenticated owner can access
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Folders subcollection - only authenticated owner can access
      match /folders/{folderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Documents subcollection - only authenticated owner can access
      match /documents/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Settings and sync metadata
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /syncMetadata/{metaDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

