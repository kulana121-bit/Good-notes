rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny for all paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Authenticated user data isolation: each user can only read and write their own documents
    match /users/{userId}/{allUserFiles=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
